# mode: demo
# size: 1240x800
#
# Ctrl+N opens the record dialog on the amount. Enter there saves the record
# in the category it starts on, that of the latest record. A category pressed
# saves at once: Tab from the amount reaches the first of them, the most
# used, and Space presses it. The list and the balance show both.
wait:2500
expect:records=44
expect:balance=1 054 237.45 ₽
key:ctrl-n
wait:900
expect:dialog=open
type:125.50
wait:300
key:enter
wait:900
expect:dialog=closed
expect:records=45
expect:balance=1 054 111.95 ₽
key:ctrl-n
wait:900
expect:dialog=open
type:10
wait:300
key:tab
wait:300
key:space
wait:900
expect:dialog=closed
expect:records=46
expect:balance=1 054 101.95 ₽
quit
