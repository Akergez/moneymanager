# mode: demo
# size: 400x800
#
# The phone-sized layout draws every screen, and its commands still work.
wait:2500
expect:stage=workspace
expect:layout=phone
expect:records=44
key:ctrl-2
wait:600
expect:screen=categories
key:ctrl-3
wait:900
expect:screen=charts
key:ctrl-n
wait:900
expect:dialog=open
key:escape
wait:600
expect:dialog=closed
# The bar along the bottom: "Transactions", then "Charts".
click:333,765
wait:600
expect:screen=charts
click:66,765
wait:600
expect:screen=transactions
# The round button floating over the corner is "new". It lies over a row of
# the list, and the press is its alone: one dialog opens, so one Escape is
# back at the list. If the row under it had opened too, its dialog would
# still be up.
click:355,683
wait:900
expect:dialog=open
key:escape
wait:700
expect:dialog=closed
quit
