# mode: demo
# size: 400x800
# input: touch
#
# The phone draws every section, and its commands still work.
wait:2500
expect:stage=workspace
expect:layout=compact
expect:records=44
key:ctrl-2
wait:600
expect:screen=categories
key:ctrl-3
wait:900
expect:screen=charts
key:ctrl-n
wait:1000
expect:sheet=open
key:escape
wait:700
expect:sheet=closed
# The navigation bar along the bottom: "Charts", then "Transactions".
click:333,760
wait:600
expect:screen=charts
click:66,760
wait:600
expect:screen=transactions
# The round button floating over the corner is "new". It lies over a row of
# the list, and the press is its alone: one sheet opens, so one Escape is
# back at the list. If the row under it had opened too, its sheet would
# still be up.
click:350,660
wait:1000
expect:sheet=open
key:escape
wait:800
expect:sheet=closed
quit
