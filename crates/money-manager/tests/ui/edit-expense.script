# mode: demo
# size: 1240x800
#
# Open is about the selected record: with none selected Ctrl+E does nothing.
# Down selects the first record and Ctrl+E (or Enter) opens it; saving it
# unchanged leaves the ledger as it was. A press on a row opens it too.
wait:2500
key:ctrl-e
wait:600
expect:dialog=closed
key:down
wait:300
key:ctrl-e
wait:900
expect:dialog=open
key:enter
wait:900
expect:dialog=closed
expect:records=44
expect:balance=1 054 237.45 ₽
# The second row of the table.
click:700,236
wait:900
expect:dialog=open
key:escape
wait:600
expect:dialog=closed
expect:records=44
quit
