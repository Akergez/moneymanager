# mode: demo
# size: 400x800
# Account management remains reachable through the phone's account menu,
# in a sheet from the bottom, as every form on a phone is.
wait:2500
expect:layout=phone
click:160,16
wait:500
key:up
key:enter
wait:800
expect:sheet=open
shot:accounts-phone
key:escape
wait:400
expect:sheet=closed
quit
