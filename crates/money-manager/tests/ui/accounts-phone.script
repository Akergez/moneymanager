# mode: demo
# size: 400x800
# input: touch
# Account management is reachable through the account switcher under the
# page's title, whose menu is a sheet on a phone, and the list of accounts
# is a sheet too.
wait:2500
expect:layout=compact
click:178,213
wait:900
expect:sheet=open
# "Accounts…", the last row of the menu's sheet.
click:100,759
wait:1200
expect:sheet=open
shot:accounts-phone
key:escape
wait:400
expect:sheet=closed
quit
