# mode: demo
# size: 400x800
# input: touch
#
# On a phone the record is a sheet at the bottom: the round button opens it
# with the amount focused, a category is chosen by pressing it, and Add at
# the sheet's top saves. The sheet goes away by its handle dragged down —
# a short drag springs back — by a press on the dimmed window above it, and
# by Escape, which is a phone's back.
wait:2500
expect:records=44
expect:balance=1 054 237.45 ₽
click:350,660
wait:1000
expect:sheet=open
type:42
wait:300
# "Food & dining": chosen, not saved.
click:77,310
wait:500
expect:sheet=open
expect:records=44
# Add.
click:351,90
wait:1000
expect:sheet=closed
expect:records=45
expect:balance=1 054 195.45 ₽
# The handle dragged a little springs back...
click:350,660
wait:1000
press:200,52
wait:200
move:200,117
wait:200
release:200,117
wait:600
expect:sheet=open
# ...and dragged far enough, the sheet goes away with nothing saved.
press:200,52
wait:200
move:200,170
wait:200
move:200,330
wait:200
release:200,330
wait:800
expect:sheet=closed
expect:records=45
# A press above the sheet, on the dimmed strip it leaves at full height,
# puts it away too.
click:350,660
wait:1000
click:200,18
wait:800
expect:sheet=closed
# And Escape.
click:350,660
wait:1000
key:escape
wait:800
expect:sheet=closed
expect:records=45
quit
