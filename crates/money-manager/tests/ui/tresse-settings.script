# mode: demo
# size: 1240x800
#
# Tresse configuration is saved from the GUI, read again on reopening, and
# removed explicitly without removing the ledger. The string goes in on the
# Server tab; the fields are cleared on Custom storage. The clicks are the
# settled positions (the scroll eases for a while after the step).
wait:2500
expect:remote=no
key:ctrl-,
wait:900
scroll:620,400,-2000
wait:900
shot:tresse-settings
click:590,524
type:tresse://http?url=http%3A%2F%2F127.0.0.1%3A9&token=test&repo_id=money-test&encryption_key=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA%3D
click:973,524
wait:500
click:811,738
wait:700
expect:dialog=closed
expect:remote=yes
key:ctrl-,
wait:700
scroll:620,400,-2000
wait:900
shot:tresse-settings-saved
click:378,296
wait:600
scroll:620,400,-2000
wait:900
click:293,559
wait:300
click:811,738
wait:700
expect:dialog=closed
expect:remote=no
expect:records=44
quit
