# mode: demo
# size: 1240x800
#
# The monthly bars and the running total each leave out the categories their
# own toggles say, and neither's choice touches the other's. Switching to
# income forgets both: the categories hidden were of the other kind.
wait:2500
key:ctrl-3
wait:900
expect:screen=charts
expect:bars-hidden=0
expect:line-hidden=0
# "Transfer", in the bars' row of toggles.
click:1000,165
wait:500
expect:bars-hidden=1
expect:line-hidden=0
# "Utilities", in the running total's.
click:420,553
wait:500
expect:bars-hidden=1
expect:line-hidden=1
# The same toggle again puts the category back.
click:1000,165
wait:500
expect:bars-hidden=0
key:ctrl-e
wait:500
expect:mode=income
expect:line-hidden=0
quit
